# mock: local demo / agaeye: wlsdn66597/aga-eye server / api: older custom /api contract
VITE_DATA_MODE=mock
# agaeye device ID must match edge/run_edge.py --device-id (upstream default: crib-01).
VITE_DEVICE_ID=crib-01
# Empty = same-origin development proxy. Avoid direct cross-origin URLs without backend CORS.
VITE_API_BASE_URL=
# Vite-only target for /agaeye-api (rewritten to /) and legacy /api (unchanged).
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_STALE_AFTER_MS=12000
