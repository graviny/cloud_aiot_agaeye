[Unit]
Description=agaeye Raspberry Pi connection
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace agaeye with the Raspberry Pi login user that ran pair.
User=agaeye
EnvironmentFile=/etc/agaeye-device.env
ExecStart=/usr/bin/python3 /opt/agaeye/raspberry-pi/agaeye_device.py run
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Must match AGAEYE_STATE_DIR and be owned by User above.
ReadWritePaths=/var/lib/agaeye

[Install]
WantedBy=multi-user.target
