# Copy to .env for the local Docker Compose setup. Fill with independent random secrets.
DATABASE_PASSWORD=
JWT_SECRET=
WORKER_KEY=
CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
FRONTEND_URL=http://localhost:5177

